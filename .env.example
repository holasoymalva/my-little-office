# --- Model providers -------------------------------------------------------
# Set at least one. Each agent in super-agent.config.json points at a provider.

# ChatGPT / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini / Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Grok / xAI
XAI_API_KEY=
XAI_MODEL=grok-4
# XAI_BASE_URL=https://api.x.ai/v1

# --- Issue tracker ---------------------------------------------------------
# Personal API key from Linear → Settings → Security & access → API keys
LINEAR_API_KEY=
LINEAR_TEAM_KEY=

# --- Runtime ---------------------------------------------------------------
AGENT_PORT=8787
# The dashboard reads this at build time to find the runtime.
NEXT_PUBLIC_AGENT_API=http://localhost:8787
